# ONE switch for the whole project: chipnet | mainnet
BCH_NETWORK=chipnet
# Optional: comma-separated Fulcrum WSS hosts overriding the defaults in packages/core/src/network.ts
BCH_ELECTRUM_SERVERS=

# Generated by `pnpm wallets:new` (never commit real values)
MAINTAINER_WIF=
CONTRIBUTOR_WIF=
CHARITY_WIF=

# Web app (Vite)
VITE_WIZ_RELAY_PRIMARY=wss://relay.riften.net:443
VITE_WIZ_RELAY_FALLBACK=wss://relay.cauldron.quest:443
VITE_BLAZE_VIDEO_URL=
# Set to /<repo>/ when deploying to GitHub Pages under a project path
VITE_BASE=

# GitHub Action
BOND_ACTION_OWNER=
BOND_APP_URL=

# Optional: run the Action e2e against a real repo you control (needs issues: write)
GITHUB_TOKEN=
BOND_E2E_REPO=
